# Replace the domain, obtain a certificate, then install this HTTPS site.
# The release manager owns the included location blocks. See MOBILE-DEPLOYMENT.md.
server {
    listen 80;
    listen [::]:80;
    server_name mapa.example.ni;
    access_log off;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 308 https://$host$request_uri; }
}
server {
    # Compatible with Ubuntu 24.04 nginx; newer nginx also accepts this spelling.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name mapa.example.ni;
    ssl_certificate /etc/letsencrypt/live/mapa.example.ni/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mapa.example.ni/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /var/log/nginx/nicanav.error.log warn;
    client_max_body_size 8m;
    client_body_timeout 120s;
    proxy_connect_timeout 5s;
    proxy_read_timeout 45s;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    include /etc/nginx/nicanav-current.conf;
}

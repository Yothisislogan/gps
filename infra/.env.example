# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp infra/.env.example infra/.env && ${EDITOR:-nano} infra/.env

# --- secrets (generate, do not invent) --------------------------------------
#
#     openssl rand -hex 24
#
# Hex avoids shell/env interpolation surprises. Database passwords are also
# URL-encoded by common/config.py. Keep this file private (chmod 600).
NICANAV_MEILI_KEY=
NICANAV_PG_PASSWORD=
NICANAV_ADMIN_PASSWORD=
NICANAV_ADMIN_USER=admin

# --- public surface ----------------------------------------------------------
# Every published port binds to 127.0.0.1 (see docs/SERVER.md): Docker writes
# its own iptables rules and bypasses UFW, so a 0.0.0.0 bind is public.
NICANAV_HTTP_PORT=8400
NICANAV_PUBLIC_BASE_URL=https://mapa.example.ni
# Comma-separated. Lock this down once the PWA has a real hostname.
NICANAV_CORS_ORIGINS=https://mapa.example.ni

# --- paths (relative to infra/, or absolute) --------------------------------
NICANAV_DATA_DIR=../data
NICANAV_TILES_DIR=../data/tiles
NICANAV_VALHALLA_DIR=../data/valhalla

# --- database ----------------------------------------------------------------
NICANAV_PG_DB=nicanav
NICANAV_PG_USER=nicanav

# --- tuning ------------------------------------------------------------------
# Start with two Valhalla service threads; size from measured serving and build peaks.
NICANAV_VALHALLA_THREADS=2
NICANAV_LOG_LEVEL=INFO

# --- optional integrations ---------------------------------------------------
# Street-level photos on POI cards (CC BY-SA, credited in the UI).
# Without it the photo section is simply absent.
NICANAV_MAPILLARY_TOKEN=
